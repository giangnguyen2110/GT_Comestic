@model NhomGT_ComesticShop.Models.Supplier

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Supplier</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-4">
                        Bạn có chắc chắn muốn xoá nhà cung cấp này không?
                    </h5>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Tên công ty</label>
                        <input value="@Model.CompanyName" class="form-control" disabled />
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Số điện thoại</label>
                        <input value="@Model.Phone" class="form-control" disabled />
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="text-right">
                            <a asp-action="Index" class="btn btn-secondary px-4">Huỷ</a>
                            <button type="submit" class="btn btn-danger px-4">Xoá</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>