  <script>
    // Truyền thêm thuộc tính isDefault vào mảng JSON
    window.productVariants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductVariants.Select(v => new {
    uid = v.Uid,
    price = v.Price,

    image = Url.Content("~/ProductVariant/" + v.ImageUrl),

    isDefault = v.IsDefault ?? false,

    options = v.ProductVariantOptionValues.ToDictionary(
        x => x.ProductOptionValue.ProductOption.Name,
        x => x.ProductOptionValue.Name
    )
   })));
    
    // Đếm số nhóm option thực tế để JS dùng logic so sánh
    window.totalGroups = parseInt('@(optionGroups?.Count() ?? 0)');
</script>
</div>

