@model NhomGT_ComesticShop.DTOs.RegisterVM

<div class="container d-flex justify-content-center align-items-center w-75"
     style="min-height:80vh;">

    <div class="col-md-8 col-lg-8">

        <div class="card border-0 shadow-lg rounded-4">

            <div class="card-body p-5">

                <h3 class="text-center mb-1 fw-bold">Create account</h3>
                <p class="text-center text-muted mb-4">Đăng ký tài khoản mới</p>

                <form asp-action="Register" method="post">

                    <!-- FULL NAME -->
                    <div class="mb-3">
                        <label>Họ tên</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- EMAIL + OTP -->
                    <div class="row">

                        <div class="col-8">
                            <label>Email</label>
                            <input asp-for="Email" id="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-4 d-flex align-items-end">
                            <button type="button"
                                    id="sendOtpBtn"
                                    class="btn btn-warning w-100">
                                Send OTP
                            </button>
                        </div>

                    </div>

                    <!-- PHONE -->
                    <div class="mb-3 mt-3">
                        <label>Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <!-- PASSWORD -->
                    <div class="row">

                        <div class="col-6">
                            <label>Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control" />
                        </div>

                        <div class="col-6">
                            <label>Xác nhận mật khẩu</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        </div>

                    </div>

                    <!-- OTP INPUT -->
                    <div class="mt-3">
                        <label>Mã OTP</label>
                        <input name="Otp" class="form-control" placeholder="Nhập OTP" />
                    </div>

                    <div asp-validation-summary="All" class="text-danger mt-2"></div>

                    <button type="submit" class="btn btn-success w-100 mt-3">
                        Đăng ký
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
   
}