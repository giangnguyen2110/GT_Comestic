@model NhomGT_ComesticShop.Models.Product

<div class="container mt-5">
    <div class="row">
        <div class="col-md-5">
            <div class="card border-0">
                <img src="~/Picture/@Model.Picture" class="img-fluid rounded" style="object-fit:cover;" />
            </div>
        </div>

        <div class="col-md-7">
            <h2 class="font-weight-bold">@Model.ProductName</h2>
            <h4 class="text-primary mt-3">@Model.UnitPrice.Value.ToString("N0") VNĐ</h4>

            <hr />

            <h5>Mô tả sản phẩm:</h5>
            <p class="text-muted">@Model.Description</p>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                <button class="btn btn-success px-4">Thêm vào giỏ hàng</button>
            </div>
        </div>
    </div>
</div>