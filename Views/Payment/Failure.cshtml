@model NhomGT_ComesticShop.DTOs.Momo.MomoExecuteResponseModel

@{
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="text-danger mb-3">Thanh toán không thành công</h2>

                    <div class="alert alert-light text-start border">
                        <p><strong>Mã đơn hàng:</strong> @Model.OrderId</p>
                        <p><strong>Số tiền:</strong> @(string.Format("{0:N0}", double.Parse(Model.Amount))) VNĐ</p>
                        <p><strong>Lý do:</strong> @Model.Message</p>
                        <p class="text-muted small">Mã lỗi MoMo: @Model.ResultCode</p>
                    </div>

                    <p class="mb-4">Giao dịch của bạn đã bị hủy hoặc gặp sự cố kỹ thuật. Vui lòng thử lại hoặc chọn phương thức thanh toán khác.</p>

                    <div class="d-grid gap-2">
                        <a href="/Checkout" class="btn btn-danger">Thanh toán lại</a>
                        <a href="/" class="btn btn-outline-secondary">Quay về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">